{
  "formatVersion": 1,
  "name": "Material 3 type scale",
  "reference": "https://m3.material.io/styles/typography/type-scale-tokens",
  "font": {
    "family": "Inter",
    "fallbacks": [
      "Roboto",
      "Noto Sans",
      "Noto Sans CJK",
      "sans-serif"
    ],
    "emojiFamily": "Noto Color Emoji",
    "units": "sp"
  },
  "roles": {
    "displayLarge": {
      "weight": 400,
      "size": 57,
      "lineHeight": 64,
      "letterSpacing": -0.25
    },
    "displayMedium": {
      "weight": 400,
      "size": 45,
      "lineHeight": 52,
      "letterSpacing": 0
    },
    "displaySmall": {
      "weight": 400,
      "size": 36,
      "lineHeight": 44,
      "letterSpacing": 0
    },
    "headlineLarge": {
      "weight": 400,
      "size": 32,
      "lineHeight": 40,
      "letterSpacing": 0
    },
    "headlineMedium": {
      "weight": 400,
      "size": 28,
      "lineHeight": 36,
      "letterSpacing": 0
    },
    "headlineSmall": {
      "weight": 400,
      "size": 24,
      "lineHeight": 32,
      "letterSpacing": 0
    },
    "titleLarge": {
      "weight": 400,
      "size": 22,
      "lineHeight": 28,
      "letterSpacing": 0
    },
    "titleMedium": {
      "weight": 500,
      "size": 16,
      "lineHeight": 24,
      "letterSpacing": 0.15
    },
    "titleSmall": {
      "weight": 500,
      "size": 14,
      "lineHeight": 20,
      "letterSpacing": 0.1
    },
    "bodyLarge": {
      "weight": 400,
      "size": 16,
      "lineHeight": 24,
      "letterSpacing": 0.5
    },
    "bodyMedium": {
      "weight": 400,
      "size": 14,
      "lineHeight": 20,
      "letterSpacing": 0.25
    },
    "bodySmall": {
      "weight": 400,
      "size": 12,
      "lineHeight": 16,
      "letterSpacing": 0.4
    },
    "labelLarge": {
      "weight": 500,
      "size": 14,
      "lineHeight": 20,
      "letterSpacing": 0.1
    },
    "labelMedium": {
      "weight": 500,
      "size": 12,
      "lineHeight": 16,
      "letterSpacing": 0.5
    },
    "labelSmall": {
      "weight": 500,
      "size": 11,
      "lineHeight": 16,
      "letterSpacing": 0.5
    }
