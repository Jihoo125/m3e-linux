{
  "version": 2,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "nogui",
      "displayName": "libm3 + tools + tests only (any host)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MAT_BUILD_GUI": "OFF",
        "MAT_ENABLE_TESTS": "ON",
        "MAT_ENABLE_TOOLS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Full development build (Debug)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MAT_BUILD_GUI": "ON",
        "MAT_ENABLE_SHELL": "ON",
        "MAT_ENABLE_APPS": "ON",
        "MAT_ENABLE_COMPOSITOR": "ON",
        "MAT_ENABLE_INSTALLER": "ON",
        "MAT_ENABLE_TESTS": "ON",
        "MAT_ENABLE_TOOLS": "ON"
      }
    },
    {
      "name": "rel",
      "displayName": "Release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "MAT_BUILD_GUI": "ON",
        "MAT_ENABLE_SHELL": "ON",
        "MAT_ENABLE_APPS": "ON",
        "MAT_ENABLE_COMPOSITOR": "ON",
        "MAT_ENABLE_INSTALLER": "ON",
        "MAT_ENABLE_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer/UBSan (CI)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MAT_BUILD_GUI": "OFF",
        "MAT_ENABLE_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "nogui", "configurePreset": "nogui" },
    { "name": "dev",   "configurePreset": "dev" },
    { "name": "rel",   "configurePreset": "rel" },
    { "name": "asan",  "configurePreset": "asan" }
  ],
  "testPresets": [
    {
      "name": "nogui",
      "configurePreset": "nogui",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    }
  ]
}
